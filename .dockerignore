# Exclude all dotfiles/dirs (.git, .github, .vscode, .gitignore, ...) except what runtime needs
.*
# .tmp/ is the runtime scratch dir for db backup/restore
!.tmp

*.md

# Editor/OS junk at any depth
**/*~
**/*.swp
**/*.swo
**/*.bak
**/*.orig
**/*.rej
**/*.tmp
**/.DS_Store

# Build/dev-only files; not used at runtime
Dockerfile
docker-compose.yaml
/tests/
/dev/
/build/

# README screenshots and capture script; not used at runtime
/screenshots/